{
    "extends": "../../tsconfig.build-cjs.json",
    "compilerOptions": {
        "outDir": "./dist/cjs",
        "lib": ["DOM"],
        "module": "CommonJS",
        "target": "ES2017",
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": false
    },
    "include": ["./src"],
    "exclude": ["node_modules", "dist", "**/*.spec.*"]
}
